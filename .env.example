# Su Ödeme Merkezi — örnek ortam değişkenleri
# Bu dosya GERÇEK GİZLİ BİLGİ İÇERMEZ. Kopyalayın: cp .env.example .env  ve değerleri ortamınıza göre doldurun.
# Üretimde değerleri dosyadan değil, barındırma platformunun secret manager / ortam değişkeni altyapısından verin.

# --- Uygulama ---
APP_ENV=development                      # development | test | staging | production
APP_BASE_URL=http://localhost:5173       # Web arayüzünün adresi (üretimde https zorunlu)
API_PUBLIC_URL=http://localhost:5173     # Webhook ve ödeme dönüş adresleri için dışarıdan erişilen API kökü (üretimde https)
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=false                        # TLS sonlandıran ters vekil arkasında true
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Veritabanı (PostgreSQL 14+) ---
DATABASE_URL=postgres://su_dev:BURAYA_YEREL_PAROLA@localhost:5432/su_dev

# --- Kimlik doğrulama ve gizli bilgiler ---
# Üretin: openssl rand -hex 32
AUTH_SECRET=
# Yerel şifreli kasa anahtarı (32 bayt, base64). Üretin: openssl rand -base64 32
# Üretimde KMS/secret manager tarafından sağlanmalı ve düzenli döndürülmelidir.
SECRETS_ENCRYPTION_KEY=
SECRET_MANAGER_REFERENCE=local-encrypted-db

# --- Süper yönetici kurulumu (yalnızca bootstrap-super-admin komutu kullanır) ---
SUPER_ADMIN_EMAIL=
MFA_REQUIRED_FOR_SUPER_ADMIN=true

# --- Ödeme sağlayıcısı ---
# Sağlayıcı ayarları ve anahtarları yönetim panelinden (Güvenli Ödeme Hizmeti) girilir; anahtar değerleri burada TUTULMAZ.
PAYMENT_PROVIDER_MODE=TEST
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_MERCHANT_ID=
PAYMENT_PROVIDER_SECRET_REF=payment/test/<saglayici-kodu>-api-key
PAYMENT_PROVIDER_WEBHOOK_SECRET_REF=payment/test/<saglayici-kodu>-webhook-secret

# --- Su idaresi ---
WATER_UTILITY_MODE=TEST
WATER_UTILITY_BASE_URL=
WATER_UTILITY_CREDENTIAL_REF=utility/test/<kurum-kodu>-credential

# --- Bildirim ---
EMAIL_FROM=
# SMTP bağlantı adresi (smtps://kullanici:parola@sunucu:465) gizli kasada bu referansla saklanır
EMAIL_PROVIDER_SECRET_REF=notification/live/smtp-url
SMS_PROVIDER_SECRET_REF=

# --- Yedekleme ---
BACKUP_STORAGE_REFERENCE=
